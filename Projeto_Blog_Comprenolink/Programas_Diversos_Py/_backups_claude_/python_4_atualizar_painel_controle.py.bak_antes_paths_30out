# ---------------------------------------------------------------- leitura dos HTML
def limpa(s):
    s = re.sub(r"<br\s*/?>", " | ", s or "")
    s = html.unescape(re.sub(r"<[^>]+>", "", s))
    return re.sub(r"\s+", " ", s).strip()


def num(s):
    s = limpa(s).replace(".", "").replace(",", ".").replace("%", "").strip()
    try:
        return float(s) if "." in s else int(s)
    except ValueError:
        return None


def partes(celula):
    """'botao_home<br><small>botao_rodape</small>' -> ['botao_home', 'botao_rodape']"""
    return [limpa(p) for p in re.split(r"<br\s*/?>", celula)]


def cards(t):
    """{titulo_h2_sem_emoji: html_do_card}"""
    out = {}
    pedacos = re.split(r'<div class="card', t)
    for p in pedacos[1:]:
        m = re.search(r"<h2>(.*?)</h2>", p, re.S)
        if m:
            titulo = re.sub(r"^[^\wÀ-ÿ]+", "", limpa(m.group(1)))
            out[titulo] = p
    return out


def linhas_tabela(card_html):
    m = re.search(r"<table>(.*?)</table>", card_html, re.S)
    if not m:
        return []
    linhas = []
    for tr in re.findall(r"<tr>(.*?)</tr>", m.group(1), re.S):
        tds = re.findall(r"<td[^>]*>(.*?)</td>", tr, re.S)
        if tds:
            linhas.append(tds)
    return linhas


def barras(card_html):
    return [(limpa(r), num(v)) for r, v in
            re.findall(r'<span class="rot">(.*?)</span>.*?<span class="val">(\d+)', card_html, re.S)]


def data_curta(txt, ano_ref, data_ref):
    """'22/10 01:08' -> datetime (ano inferido pela data do relatório)."""
    m = re.match(r"(\d{2})/(\d{2})(?:\s+(\d{2}):(\d{2}))?", txt or "")
    if not m:
        return None
    d, mes = int(m.group(1)), int(m.group(2))
    h, mi = int(m.group(3) or 0), int(m.group(4) or 0)
    dt = datetime(ano_ref, mes, d, h, mi)
    if dt - data_ref > timedelta(days=60):  # virada de ano
        dt = dt.replace(year=ano_ref - 1)
    return dt


def ler_relatorio(caminho):
    t = open(caminho, encoding="utf-8").read()
    m = re.search(r"gerado em:</strong>\s*(\d{2}/\d{2}/\d{4}) às (\d{2}:\d{2})", t)
    gerado = datetime.strptime(m.group(1) + " " + m.group(2), "%d/%m/%Y %H:%M")
    kpi = {}
    for v, l in re.findall(r'<div class="v">(.*?)</div><div class="l">(.*?)</div>', t, re.S):
        kpi[limpa(l)] = num(v)

    def k(prefixo):
        for rot, val in kpi.items():
            if prefixo.lower() in rot.lower():
                return val
        return None

    m = re.search(r"(\d+) acessos de outras páginas", t)
    q = {
        "arquivo": os.path.basename(caminho),
        "gerado": gerado,
        "ao_vivo": k("Acessando agora") or 0,
        "visitas": k("Visitas (páginas vistas)") or 0,
        "visitantes": k("Visitantes únicos") or 0,
        "vindas_link": k("Visitas vindas de anúncio") or 0,
        "cliques": k("Cliques em link de afiliado") or 0,
        "possiveis": k("Possíveis compras") or 0,
        "aprovadas": k("Vendas APROVADAS"),
        "pendentes": k("Vendas pendentes"),
        "outras_paginas": int(m.group(1)) if m else None,
    }
    c = cards(t)

    def card(prefixo):
        for tit, h in c.items():
            if tit.lower().startswith(prefixo.lower()):
                return h
        return ""

    campanhas = []
    for tds in linhas_tabela(card("Desempenho por anúncio")):
        camp = partes(tds[2]) + [""]
        campanhas.append({
            "tipo": limpa(tds[0]), "canal": limpa(tds[1]), "campanha": camp[0], "conteudo": camp[1],
            "visitas": num(tds[3]) or 0, "visitantes": num(tds[4]) or 0, "cliques": num(tds[5]) or 0,
            "possiveis": num(tds[7]) or 0, "aprovadas": num(tds[8]) or 0, "comissao": num(tds[9]) or 0})

    produtos = [{"produto": limpa(tds[1]), "cliques": num(tds[2]) or 0, "origens": limpa(tds[3])}
                for tds in linhas_tabela(card("Produtos mais clicados"))]

    possiveis_ids = {limpa(tds[0]) for tds in linhas_tabela(card("Possíveis compras"))}

    visitantes = []
    for tds in linhas_tabela(card("Visitantes")):
        origem = partes(tds[3]) + [""]
        aparelho = partes(tds[4]) + [""]
        vid = limpa(tds[0]).replace(" online", "").split()[0]
        visitantes.append({
            "id": vid, "ultimo": data_curta(limpa(tds[1]), gerado.year, gerado),
            "primeiro": data_curta(limpa(tds[2]), gerado.year, gerado),
            "canal": origem[0], "origem": origem[1], "aparelho": aparelho[0], "sistema": aparelho[1],
            "visitas": num(tds[5]) or 0, "cliques": num(tds[6]) or 0, "produtos": limpa(tds[7]),
            "intencao": limpa(tds[8]).replace("🔥", "").strip(), "possivel": "S" if vid in possiveis_ids else ""})

    dias, horas = [], []
    for rot, v in re.findall(r'<div class="col" title="([^":]+): (\d+)"', t):
        if rot.endswith("h"):
            horas.append((int(rot[:-1]), int(v)))
        else:
            dias.append((data_curta(rot, gerado.year, gerado), int(v)))

    perfil = {nome: barras(card(nome)) for nome in ("Dispositivo", "Sistema", "Canal", "De onde vêm", "Aberto dentro")}
    return {"q": q, "campanhas": campanhas, "produtos": produtos, "visitantes": visitantes,
            "dias": dias, "horas": horas, "perfil": perfil}


# ---------------------------------------------------------------- vendas do ML Afiliados
def _col(cab, *chaves, usados=()):
    """Índice da 1ª coluna que contém a chave (chaves em ordem de prioridade), ignorando as já usadas."""
    for ch in chaves:
        for i, c in enumerate(cab):
            if i not in usados and ch in (c or "").strip().lower():
                return i
    return None


def _valor(v):
    if v is None or v == "":
        return None
    if isinstance(v, (int, float)):
        return float(v)
    s = str(v).replace("R$", "").strip()
    if "," in s:
        s = s.replace(".", "").replace(",", ".")
    try:
        return float(s)
    except ValueError:
        return None


def _data(v):
    if isinstance(v, datetime):
        return v
    for fmt in ("%d/%m/%Y %H:%M:%S", "%d/%m/%Y %H:%M", "%d/%m/%Y", "%Y-%m-%d %H:%M:%S", "%Y-%m-%d %H:%M", "%Y-%m-%dT%H:%M:%S", "%Y-%m-%d"):
        try:
            return datetime.strptime(str(v).strip()[:19], fmt)
        except ValueError:
            pass
    return None


def ler_vendas():
    vendas, avisos = [], []
    for caminho in sorted(glob.glob(os.path.join(PASTA_VENDAS, "*"))):
        ext = os.path.splitext(caminho)[1].lower()
        try:
            if ext == ".csv":
                bruto = open(caminho, encoding="utf-8-sig", errors="replace").read()
                sep = ";" if bruto.count(";") > bruto.count(",") else ","
                linhas = list(csv.reader(bruto.splitlines(), delimiter=sep))
            elif ext in (".xlsx", ".xlsm"):
                ws = load_workbook(caminho, read_only=True, data_only=True).active
                linhas = [list(r) for r in ws.iter_rows(values_only=True)]
            else:
                continue
        except Exception as e:  # arquivo aberto/corrompido: segue sem ele
            avisos.append(f"{os.path.basename(caminho)}: {e}")
            continue
        if not linhas:
            continue
        cab = [str(c or "") for c in linhas[0]]
        usados = set()

        def achar(*chaves):
            i = _col(cab, *chaves, usados=usados)
            if i is not None:
                usados.add(i)
            return i
        i_com = achar("comiss", "taxa de venda", "sua taxa", "ganho", "earning")
        i_pedido = achar("pedido", "ordem", "order", "nº da venda", "n° da venda", "id da venda", "venda #", "#")
        i_data = achar("data", "fecha", "date")
        i_status = achar("status", "estado", "situação")
        i_prod = achar("produto", "título", "titulo", "item", "anúncio")
        i_loja = achar("loja", "vendedor", "seller")
        i_qtd = achar("quantidade", "unidades", "qtd")
        i_camp = achar("campanha", "etiqueta", "sub_id", "origem", "tag")
        i_valor = achar("valor", "preço", "preco", "total", "venda")
        if i_data is None or (i_com is None and i_valor is None):
            avisos.append(f"{os.path.basename(caminho)}: colunas de data/comissão não reconhecidas ({', '.join(cab[:8])})")
            continue
        for r in linhas[1:]:
            if not r or all(c in (None, "") for c in r):
                continue
            pega = lambda i: r[i] if i is not None and i < len(r) else None
            estado = str(pega(i_status) or "")
            vendas.append({"pedido": re.sub(r"[^0-9A-Za-z]", "", str(pega(i_pedido) or "")),
                           "data": _data(pega(i_data)), "produto": pega(i_prod) or "", "loja": pega(i_loja) or "",
                           "campanha": pega(i_camp) or "", "status": normalizar_status(estado), "estado_ml": estado,
                           "qtd": _valor(pega(i_qtd)), "valor": _valor(pega(i_valor)),
                           "comissao": _valor(pega(i_com)), "fonte": os.path.basename(caminho)})
    return vendas, avisos


def normalizar_status(estado):
    """Estado do ML Afiliados -> Aprovada / Pendente / Cancelada (o original fica em 'Estado no ML')."""
    e = (estado or "").lower()
    if any(k in e for k in ("cancel", "não efetiv", "nao efetiv", "devolv", "estorn", "recus", "reembols")):
        return "Cancelada"
    if any(k in e for k in ("aprov", "pago", "paga", "liberad", "confirm", "efetivad", "disponív", "disponiv")):
        return "Aprovada"
    return "Pendente"  # em revisão, pendente, aguardando, em análise...


def consolidar_vendas(novas):
    """Junta as vendas exportadas ao histórico permanente (1 linha por pedido; a importação mais nova
    atualiza estado, valor e comissão). Vendas sem nº de pedido usam data+produto+valor como chave."""
    os.makedirs(os.path.dirname(HIST_VENDAS), exist_ok=True)
    hist = {}
    if os.path.exists(HIST_VENDAS):
        for r in csv.DictReader(open(HIST_VENDAS, encoding="utf-8-sig"), delimiter=";"):
            hist[r["pedido"]] = r
    agora = datetime.now().strftime("%Y-%m-%d %H:%M")
    for v in novas:
        chave = v["pedido"] or f'SEM-{v["data"]:%Y%m%d%H%M}-{str(v["produto"])[:20]}-{v["valor"]}' if v["data"] else v["pedido"]
        if not chave:
            continue
        linha = {"pedido": chave, "data": v["data"].strftime("%Y-%m-%d %H:%M") if v["data"] else "",
                 "produto": v["produto"], "loja": v["loja"], "campanha": v["campanha"], "status": v["status"],
                 "estado_ml": v["estado_ml"], "qtd": v["qtd"] if v["qtd"] is not None else "",
                 "valor": v["valor"] if v["valor"] is not None else "",
                 "comissao": v["comissao"] if v["comissao"] is not None else "", "fonte": v["fonte"],
                 "primeira_vez": hist.get(chave, {}).get("primeira_vez") or agora, "atualizado_em": agora}
        antigo = hist.get(chave)
        if antigo and all(str(antigo.get(k, "")) == str(linha[k]) for k in ("status", "estado_ml", "valor", "comissao")):
            continue  # nada mudou
        hist[chave] = linha
    with open(HIST_VENDAS, "w", newline="", encoding="utf-8-sig") as f:
        w = csv.DictWriter(f, fieldnames=COLS_HIST_VENDAS, delimiter=";", extrasaction="ignore")
        w.writeheader()
        w.writerows(sorted(hist.values(), key=lambda r: r["data"]))
    saida = []
    for r in hist.values():
        saida.append({"pedido": r["pedido"], "data": _data(r["data"]), "produto": r["produto"], "loja": r["loja"],
                      "campanha": r["campanha"], "status": r["status"], "estado_ml": r["estado_ml"],
                      "qtd": _valor(r["qtd"]), "valor": _valor(r["valor"]), "comissao": _valor(r["comissao"]),
                      "fonte": r["fonte"], "atualizado_em": _data(r["atualizado_em"])})
    return saida


import unicodedata

PALAVRAS_VAZIAS = {"com", "para", "sem", "por", "cor", "the", "and", "kit", "uma", "dos", "das", "que", "mais",
                   "melhor", "vendido", "produto", "novo", "original", "unidade", "unidades"}


def _tokens(texto):
    t = unicodedata.normalize("NFKD", str(texto or "").lower())
    t = "".join(c for c in t if not unicodedata.combining(c))
    t = re.sub(r"^\s*\d+\.", " ", t)
    t = re.sub(r"\([^)]*\)", " ", t)  # "(categoria ...)" não é nome do produto
    partes = [w for w in re.split(r"[^a-z0-9]+", t) if w]
    palavras = {w for w in partes if len(w) >= 3 and w not in PALAVRAS_VAZIAS}
    juntas = {a + b for a, b in zip(partes, partes[1:]) if len(a + b) >= 6}  # micro + ondas = microondas
    return palavras, juntas


def semelhanca(produto_vendido, produto_clicado):
    """Parte das palavras do produto vendido que aparecem no produto clicado (0 a 1)."""
    pa, _ = _tokens(produto_vendido)
    pb, jb = _tokens(produto_clicado)
    return len(pa & (pb | jb)) / len(pa) if pa and pb else 0.0


def atribuir_vendas(visitantes, vendas, fuso_h, janela_dias, ignorar):
    """Liga cada venda ao visitante do blog que clicou no MESMO produto entre o 1º acesso e a compra
    (até janela_dias antes). Devolve {visitante: venda} e {pedido: visitante}. Visitantes marcados como
    teste (Ignorar = S) ficam de fora."""
    por_visitante, por_pedido = {}, {}
    for v in sorted(vendas, key=lambda x: x["data"] or datetime.min):
        if not v.get("data"):
            continue
        dia_venda = v["data"].date()
        candidatos = []
        for vis in visitantes:
            if str(ignorar.get(vis["id"], "")).upper() == "S" or not vis.get("produtos") or not vis.get("ultimo"):
                continue
            primeiro = ((vis.get("primeiro") or vis["ultimo"]) + timedelta(hours=fuso_h)).date()
            ultimo = (vis["ultimo"] + timedelta(hours=fuso_h)).date()
            if not (primeiro <= dia_venda <= ultimo + timedelta(days=janela_dias)):
                continue
            nota = max(semelhanca(v["produto"], p) for p in str(vis["produtos"]).split(";"))
            if nota >= 0.5:
                candidatos.append((nota, ultimo, vis["id"]))
        if candidatos:
            _, _, vid = max(candidatos)
            por_visitante.setdefault(vid, v)
            por_pedido[v.get("pedido") or id(v)] = vid
    return por_visitante, por_pedido


