def ler_preservados():
    p = {"obs": {}, "ignorar": {}, "vendas_manuais": [], "metas": {}, "analise": None, "resumo_ml": None}
    if not os.path.exists(ARQ):
        return p
    try:
        wb = load_workbook(ARQ, data_only=False)
    except Exception:
        return p
    if "Quadros" in wb.sheetnames:
        ws = wb["Quadros"]
        cab = [c.value for c in ws[1]]
        if "Arquivo" in cab and "Observação" in cab:
            ia, io = cab.index("Arquivo"), cab.index("Observação")
            for r in ws.iter_rows(min_row=2, values_only=True):
                if r[ia] and r[io]:
                    p["obs"][r[ia]] = r[io]
    if "Visitantes" in wb.sheetnames:
        ws = wb["Visitantes"]
        cab = [c.value for c in ws[1]]
        if "Visitante" in cab and "Ignorar (S/N)" in cab:
            ii, ig = cab.index("Visitante"), cab.index("Ignorar (S/N)")
            for r in ws.iter_rows(min_row=2, values_only=True):
                if r[ii] and r[ig]:
                    p["ignorar"][r[ii]] = r[ig]
    if "Vendas" in wb.sheetnames:
        ws = wb["Vendas"]
        novo = ws.cell(1, 2).value == "Nº do pedido"
        for r in ws.iter_rows(min_row=2, values_only=True):
            if novo and len(r) >= 12 and str(r[11] or "").strip().lower().startswith("manual") and any(r[:10]):
                p["vendas_manuais"].append({"data": _data(r[0]) if not isinstance(r[0], datetime) else r[0],
                                            "pedido": re.sub(r"[^0-9A-Za-z]", "", str(r[1] or "")), "produto": r[2] or "",
                                            "loja": r[3] or "", "campanha": r[4] or "", "status": normalizar_status(str(r[6] or r[5] or "")) if r[6] else (r[5] or "Pendente"),
                                            "estado_ml": r[6] or "", "qtd": r[7], "valor": r[8], "comissao": r[9],
                                            "fonte": "manual"})
            elif not novo and len(r) >= 7 and str(r[6] or "").strip().lower() == "manual" and any(r[:6]):
                p["vendas_manuais"].append({"data": r[0], "pedido": "", "produto": r[1], "loja": "", "campanha": r[2],
                                            "status": r[3], "estado_ml": r[3], "qtd": None, "valor": r[4],
                                            "comissao": r[5], "fonte": "manual"})
    if "Resumo_ML" in wb.sheetnames:
        linhas = [list(r[:len(RESUMO_ML_COLS)]) for r in wb["Resumo_ML"].iter_rows(min_row=2, values_only=True)
                  if r and r[0] is not None and r[0] != "" and not str(r[0]).startswith("Como")]
        p["resumo_ml"] = linhas or None
    if "Metas" in wb.sheetnames:
        ws = wb["Metas"]
        for r in ws.iter_rows(min_row=4, values_only=True):
            if r[0] and r[1] is not None:
                p["metas"][r[0]] = r[1]
    if "Painel" in wb.sheetnames:
        ws = wb["Painel"]
        for row in ws.iter_rows():
            for c in row:
                if c.value == "ANÁLISE DO ESPECIALISTA (texto editável)":
                    itens = []
                    for i in range(1, 12):
                        rot = ws.cell(c.row + i, 2).value
                        txt = ws.cell(c.row + i, 4).value
                        if not rot or str(rot).strip().upper() == "GRÁFICOS":
                            break
                        itens.append((rot, txt or ""))
                    p["analise"] = itens or None
                    antigas = [[tuple(x) for x in v] for v in (ANALISE_22_10, ANALISE_23_10A, ANALISE_23_10B, ANALISE_23_10C, ANALISE_23_10D, ANALISE_23_10E,
                                                     ANALISE_27_10A, ANALISE_27_10B)]
                    if p["analise"] and [tuple(x) for x in p["analise"]] in antigas:
                        p["analise"] = None  # texto padrão antigo, nunca editado: usa o novo
    return p


# ---------------------------------------------------------------- ajudantes de escrita
def cabecalho(ws, colunas, larguras, linha=1, congelar=True):
    for i, (nome, larg) in enumerate(zip(colunas, larguras), start=1):
        c = ws.cell(linha, i, nome)
        c.font, c.fill, c.alignment, c.border = F_H, FILL_H, CENTRO, BORDA
        ws.column_dimensions[get_column_letter(i)].width = larg
    ws.row_dimensions[linha].height = 30
    if congelar:
        ws.freeze_panes = ws.cell(linha + 1, 1)


def corpo(ws, l1, l2, ncol, formatos=None):
    for r in range(l1, l2 + 1):
        for ci in range(1, ncol + 1):
            c = ws.cell(r, ci)
            c.font = c.font if c.font.color and c.font.color.rgb == "FF0000FF" else F_N
            c.border = BORDA
            if formatos and formatos.get(ci):
                c.number_format = formatos[ci]


def tabela(ws, nome, ncol, nlin):
    ref = f"A1:{get_column_letter(ncol)}{max(nlin, 2)}"
    t = Table(displayName=nome, ref=ref)
    t.tableStyleInfo = TableStyleInfo(name="TableStyleLight9", showRowStripes=True)
    ws.add_table(t)


def entrada(c, valor=None):
    if valor is not None:
        c.value = valor
    c.font, c.fill, c.border = F_INPUT, FILL_INPUT, BORDA


def grafico(ch, titulo, larg=16.5, alt=7.5):
    ch.title = titulo
    ch.width, ch.height = larg, alt
    for eixo in (getattr(ch, "x_axis", None), getattr(ch, "y_axis", None)):
        if eixo is not None:
            eixo.delete = False
            eixo.txPr = None
    if hasattr(ch, "varyColors") and not isinstance(ch, DoughnutChart):
        ch.varyColors = False
    for s in getattr(ch, "series", []):
        if isinstance(ch, LineChart):
            s.smooth = False
    for sub in getattr(ch, "_charts", []):
        if sub is not ch and isinstance(sub, LineChart):
            sub.varyColors = False
            for s in sub.series:
                s.smooth = False
    if ch.dataLabels is not None:
        for campo in ("showSerName", "showCatName", "showLegendKey"):
            setattr(ch.dataLabels, campo, False)
    if ch.legend is not None:
        ch.legend.position = "b"
        ch.legend.overlay = False
    if getattr(ch, "type", None) == "bar" and getattr(ch.x_axis.scaling, "orientation", "") == "maxMin":
        ch.y_axis.crosses = "max"  # eixo de valores embaixo quando as categorias estão invertidas
    return ch


# ---------------------------------------------------------------- montagem
def montar(rels, vendas, preservado, avisos, anuncios=None, hist_anuncios=None):
    ult = rels[-1]
    metas = {nome: preservado["metas"].get(nome, val) for nome, val, _, _ in METAS_PADRAO}
    janela = int(metas.get("Janela de atribuição: dias entre o clique no blog e a compra") or 7)
    fuso_h = float(metas.get("Fuso horário dos eventos do blog (horas em relação ao UTC)") or -3)
    compra_de, visitante_do_pedido = atribuir_vendas(ult["visitantes"], vendas, fuso_h, janela, preservado["ignorar"])
    wb = Workbook()
    wb.remove(wb.active)
    painel = wb.create_sheet("Painel")

    # ---------- Metas (entradas do usuário)
    ws = wb.create_sheet("Metas")
    ws["A1"], ws["A1"].font = "Metas e premissas (células amarelas com texto azul = você pode alterar)", F_SEC
    ws["A2"], ws["A2"].font = "Os valores aqui alimentam as projeções e os alertas do Painel. São preservados ao atualizar.", F_SUB
    cabecalho(ws, ["Item", "Valor", "Nota / fonte"], [62, 16, 80], linha=3, congelar=False)
    nome_meta = {}
    for i, (nome, val, fmt, nota) in enumerate(METAS_PADRAO, start=4):
        ws.cell(i, 1, nome).font = F_N
        c = ws.cell(i, 2)
        entrada(c, metas[nome])
        c.number_format = fmt
        ws.cell(i, 3, nota).font = F_SUB
        for ci in (1, 3):
            ws.cell(i, ci).border = BORDA
        nome_meta[nome] = f"Metas!$B${i}"
    M_FUSO, M_CTR, M_CONV, M_COM, M_SEMANA, M_BF, M_CEL = [nome_meta[n] for n, *_ in METAS_PADRAO[:7]]

    # ---------- Quadros (1 linha por relatório HTML)
    ws = wb.create_sheet("Quadros")
    col = ["Nº", "Arquivo", "Data/hora", "Rótulo", "Ao vivo", "Visitas", "Visitantes", "Vindas de link",
           "Cliques", "Possíveis compras", "Vendas aprovadas", "Vendas pendentes", "Outras páginas",
           "Δ Visitas", "Δ Cliques", "Horas desde anterior", "Visitas por hora", "Cliques por visita",
           "Cliques por visitante", "Observação"]
    cabecalho(ws, col, [5, 42, 16, 12, 8, 8, 10, 10, 8, 10, 10, 10, 10, 9, 9, 11, 10, 10, 11, 40])
    for i, rel in enumerate(rels, start=2):
        q = rel["q"]
        valores = [i - 1, q["arquivo"], q["gerado"], q["gerado"].strftime("%d/%m %H:%M"), q["ao_vivo"], q["visitas"],
                   q["visitantes"], q["vindas_link"], q["cliques"], q["possiveis"], q["aprovadas"], q["pendentes"],
                   q["outras_paginas"]]
        for ci, v in enumerate(valores, start=1):
            ws.cell(i, ci, v)
        if i == 2:
            for ci in (14, 15, 16, 17):
                ws.cell(i, ci, None)
        else:
            ws.cell(i, 14, f"=F{i}-F{i-1}")
            ws.cell(i, 15, f"=I{i}-I{i-1}")
            ws.cell(i, 16, f"=(C{i}-C{i-1})*24")
            ws.cell(i, 17, f"=IFERROR(N{i}/P{i},0)")
        ws.cell(i, 18, f"=IFERROR(I{i}/F{i},0)")
        ws.cell(i, 19, f"=IFERROR(I{i}/G{i},0)")
        entrada(ws.cell(i, 20), preservado["obs"].get(q["arquivo"]))
    nq = len(rels) + 1
    corpo(ws, 2, nq, len(col), {3: "dd/mm/yyyy hh:mm", 16: "0.0", 17: "0.0", 18: "0%", 19: "0.0"})
    tabela(ws, "tbQuadros", len(col), nq)
    ws.conditional_formatting.add(f"Q2:Q{nq}", DataBarRule(start_type="min", end_type="max", color="5B9BD5"))

    # ---------- Campanhas (último relatório)
    ws = wb.create_sheet("Campanhas")
    col = ["Tipo", "Canal", "Campanha", "Conteúdo", "Rótulo", "Visitas", "Visitantes", "Cliques", "Taxa de clique",
           "Possíveis compras", "Vendas aprovadas", "Comissão aprovada", "Classificação"]
    cabecalho(ws, col, [26, 10, 20, 20, 30, 8, 10, 8, 11, 11, 11, 12, 14])
    for i, c in enumerate(ult["campanhas"], start=2):
        rot = c["canal"] + (" · " + c["conteudo"] if c["conteudo"] and c["conteudo"] != "—" else "")
        for ci, v in enumerate([c["tipo"], c["canal"], c["campanha"], c["conteudo"], rot, c["visitas"],
                                c["visitantes"], c["cliques"]], start=1):
            ws.cell(i, ci, v)
        ws.cell(i, 9, f"=IFERROR(H{i}/F{i},0)")
        ws.cell(i, 10, c["possiveis"])
        ws.cell(i, 11, c["aprovadas"])
        ws.cell(i, 12, c["comissao"])
        ws.cell(i, 13, f'=IF(B{i}="direto","Direto",IF(B{i}="site","Interno",'
                       f'IF(OR(ISNUMBER(SEARCH("teste",C{i}&D{i})),ISNUMBER(SEARCH("127.0.0.1",B{i})),'
                       f'ISNUMBER(SEARCH("localhost",B{i}))),"Teste","Externo")))')
    nc = len(ult["campanhas"]) + 1
    corpo(ws, 2, nc, len(col), {9: "0%", 12: '"R$" #,##0.00'})
    tabela(ws, "tbCampanhas", len(col), nc)
    ws.conditional_formatting.add(f"H2:H{nc}", DataBarRule(start_type="num", start_value=0, end_type="max", color="F4B183"))
    ws.cell(nc + 2, 1, "Classificação: Interno = botões da própria home (utm_source=site); Teste = campanha com 'teste' ou vinda de 127.0.0.1/localhost (painel local); "
                       "Externo = divulgação real (TikTok, Instagram, WhatsApp...); Direto = sem etiqueta.").font = F_SUB

    # ---------- Produtos
    ws = wb.create_sheet("Produtos")
    col = ["#", "Produto", "Cliques", "% dos cliques", "Principais origens"]
    cabecalho(ws, col, [5, 70, 9, 12, 45])
    for i, p in enumerate(ult["produtos"], start=2):
        ws.cell(i, 1, i - 1)
        ws.cell(i, 2, p["produto"])
        ws.cell(i, 3, p["cliques"])
        ws.cell(i, 4, f"=IFERROR(C{i}/SUM($C$2:$C${len(ult['produtos']) + 1}),0)")
        ws.cell(i, 5, p["origens"])
    npd = len(ult["produtos"]) + 1
    corpo(ws, 2, npd, len(col), {4: "0%"})
    tabela(ws, "tbProdutos", len(col), npd)
    ws.conditional_formatting.add(f"C2:C{npd}", DataBarRule(start_type="num", start_value=0, end_type="max", color="A9D18E"))

    # ---------- Anúncios (situação no Mercado Livre)
    anuncios, hist_anuncios = anuncios or [], hist_anuncios or []
    ws = wb.create_sheet("Anuncios")
    col = ["Item", "Nome no blog", "Descrição do anúncio", "Situação", "Nº do anúncio (MLB)", "Catálogo (MLB)",
           "Aviso do ML", "Motivo provável", "Ação sugerida", "Preço no ML (R$)", "Cliques no blog",
           "Situação anterior", "Mudou?", "Verificado em", "Link do anúncio", "Link de afiliado"]
    cabecalho(ws, col, [6, 30, 55, 20, 17, 15, 40, 45, 45, 13, 10, 18, 9, 16, 40, 30])
    for i, a in enumerate(anuncios, start=2):
        catalogo = a.get("catalogo_mlb") or a.get("catalogo_no_blog") or ""
        valores = [a["_item"], a.get("nome_no_blog", ""), a.get("titulo_ml") or a.get("titulo_card", ""), a["status"],
                   a.get("anuncio_mlb", ""), catalogo, a.get("aviso_ml", ""), a.get("motivo_provavel", ""),
                   a.get("acao_sugerida", ""), _valor(a.get("preco_ml"))]
        for ci, v in enumerate(valores, start=1):
            ws.cell(i, ci, v)
        pb, pc = f"Produtos!$B$2:$B${npd}", f"Produtos!$C$2:$C${npd}"
        ws.cell(i, 11, f'=IF(B{i}="",0,SUMPRODUCT({pc},--((ISNUMBER(SEARCH(B{i},{pb}))'
                       f'+(LEFT({pb},25)=LEFT(C{i},25))*(LEN(C{i})>=25))>0)))')
        ws.cell(i, 12, a.get("_anterior", ""))
        ws.cell(i, 13, f'=IF(L{i}="","novo",IF(L{i}=D{i},"","MUDOU"))')
        ws.cell(i, 14, a["_dt"])
        for ci, chave in ((15, "url_anuncio"), (16, "link_afiliado")):
            url = a.get(chave, "")
            c = ws.cell(i, ci, url)
            if url:
                c.hyperlink = url
    na = max(len(anuncios) + 1, 2)
    corpo(ws, 2, na, len(col), {10: '"R$" #,##0.00', 14: "dd/mm/yyyy hh:mm"})
    for r in range(2, na + 1):
        for ci in (3, 7, 8, 9):
            ws.cell(r, ci).alignment = QUEBRA
        for ci in (15, 16):
            ws.cell(r, ci).font = Font(name=FONTE, size=9, color="0563C1", underline="single")
    tabela(ws, "tbAnuncios", len(col), na)
    faixa = f"D2:D{na}"
    ws.conditional_formatting.add(faixa, CellIsRule(operator="equal", formula=['"Ativo"'], fill=FILL_OK))
    ws.conditional_formatting.add(faixa, CellIsRule(operator="equal", formula=['"Pausado"'],
                                                    fill=PatternFill("solid", fgColor="FCE4D6")))
    ws.conditional_formatting.add(faixa, FormulaRule(formula=['AND(D2<>"",D2<>"Ativo",D2<>"Pausado")'], fill=FILL_RUIM))
    ws.conditional_formatting.add(f"M2:M{na}", CellIsRule(operator="equal", formula=['"MUDOU"'], fill=FILL_RUIM,
                                                          font=Font(bold=True)))
    ws.cell(na + 2, 1, "Situação lida na página pública do link de afiliado (6_verificar_anuncios.py). O Mercado Livre não "
                       "mostra publicamente o motivo de um anúncio ser pausado ou retirado; a coluna Motivo provável é uma "
                       "estimativa. Problemas aparecem primeiro.").font = F_SUB
    if not anuncios:
        ws.cell(2, 2, "Ainda não há verificação: rode o ATUALIZAR_PAINEL.bat (etapa de verificação dos anúncios).").font = F_SUB

    ws = wb.create_sheet("Anuncios_Hist")
    col = ["Verificado em", "Item", "Nome no blog", "Situação", "Nº do anúncio (MLB)", "Aviso do ML"]
    cabecalho(ws, col, [16, 6, 40, 22, 18, 60])
    hist = sorted(hist_anuncios, key=lambda r: (r["_dt"], r["_item"]), reverse=True)
    for i, a in enumerate(hist, start=2):
        for ci, v in enumerate([a["_dt"], a["_item"], a.get("nome_no_blog", ""), a["status"], a.get("anuncio_mlb", ""),
                                a.get("aviso_ml", "")], start=1):
            ws.cell(i, ci, v)
    nh = max(len(hist) + 1, 2)
    corpo(ws, 2, nh, len(col), {1: "dd/mm/yyyy hh:mm"})
    tabela(ws, "tbAnunciosHist", len(col), nh)
    ws.conditional_formatting.add(f"D2:D{nh}", FormulaRule(formula=['AND(D2<>"",D2<>"Ativo")'], fill=FILL_RUIM))

    # ---------- Visitantes
    ws = wb.create_sheet("Visitantes")
    col = ["Visitante", "Último acesso (UTC)", "1º acesso (UTC)", "Último acesso (Brasília)", "Canal", "Origem",
           "Aparelho", "Sistema", "Visitas", "Cliques", "Produtos clicados", "Intenção", "Possível compra",
           "Sugestão", "Ignorar (S/N)", "Situação da compra", "Pedido atribuído"]
    cabecalho(ws, col, [11, 16, 16, 18, 9, 20, 12, 18, 8, 8, 60, 9, 10, 16, 11, 30, 18])
    hoje = datetime.now().date()
    for i, v in enumerate(ult["visitantes"], start=2):
        for ci, x in enumerate([v["id"], v["ultimo"], v["primeiro"]], start=1):
            ws.cell(i, ci, x)
        ws.cell(i, 4, f"=IF(B{i}=\"\",\"\",B{i}+{M_FUSO}/24)")
        for ci, x in enumerate([v["canal"], v["origem"], v["aparelho"], v["sistema"], v["visitas"], v["cliques"],
                                v["produtos"], v["intencao"], v["possivel"]], start=5):
            ws.cell(i, ci, x)
        ws.cell(i, 14, f'=IF(AND(G{i}="computador",I{i}>=3),"provável teste",IF(ISNUMBER(SEARCH("teste",F{i})),"teste",""))')
        entrada(ws.cell(i, 15), preservado["ignorar"].get(v["id"]))
        venda = compra_de.get(v["id"])
        if str(preservado["ignorar"].get(v["id"], "")).upper() == "S":
            situacao = ""
        elif venda:
            situacao = ("✖ Compra cancelada" if venda["status"] == "Cancelada" else
                        "✔ Compra confirmada" + (" (aprovada)" if venda["status"] == "Aprovada" else " (em revisão)"))
            ws.cell(i, 17, venda.get("pedido") or "sem nº")
        elif v["possivel"] == "S" and v["ultimo"]:
            prazo = (v["ultimo"] + timedelta(hours=fuso_h)).date() + timedelta(days=janela)
            situacao = (f"⏳ Aguardando venda até {prazo:%d/%m}" if hoje <= prazo
                        else "✖ Não converteu (pelas vendas importadas)")
        else:
            situacao = ""
        ws.cell(i, 16, situacao)
    nv = len(ult["visitantes"]) + 1
    corpo(ws, 2, nv, len(col), {2: "dd/mm/yyyy hh:mm", 3: "dd/mm/yyyy hh:mm", 4: "dd/mm/yyyy hh:mm"})
    tabela(ws, "tbVisitantes", len(col), nv)
    ws.conditional_formatting.add(f"A2:Q{nv}", FormulaRule(formula=[f'$O2="S"'], font=Font(color="999999", italic=True)))
    ws.conditional_formatting.add(f"P2:P{nv}", FormulaRule(formula=['LEFT($P2,1)="✔"'], fill=FILL_OK))
    ws.conditional_formatting.add(f"P2:P{nv}", FormulaRule(formula=['LEFT($P2,1)="⏳"'], fill=FILL_NOTA))
    ws.conditional_formatting.add(f"P2:P{nv}", FormulaRule(formula=['LEFT($P2,1)="✖"'], fill=FILL_RUIM))
    ws.cell(nv + 2, 1, "Coluna 'Ignorar (S/N)': digite S nos acessos seus ou de teste. O Painel passa a calcular "
                       "visitantes, cliques e possíveis compras REAIS sem eles. O valor é mantido ao atualizar.").font = F_SUB
    ws.cell(nv + 3, 1, f"Situação da compra: quando uma venda registrada (aba Vendas) é de um produto que o visitante clicou "
                       f"entre o 1º acesso e até {janela} dias antes da compra, ele vira '✔ Compra confirmada'. Possível "
                       f"compra sem venda: '⏳ Aguardando' até o prazo e depois '✖ Não converteu'. Prazo: aba Metas.").font = F_SUB

    # ---------- Diário e Perfil
    ws = wb.create_sheet("Diario")
    cabecalho(ws, ["Data", "Visitas", "Média móvel 7 dias", "Acumulado"], [12, 9, 18, 11])
    for i, (d, v) in enumerate(ult["dias"], start=2):
        ws.cell(i, 1, d)
        ws.cell(i, 2, v)
        ws.cell(i, 3, f"=AVERAGE(B{max(2, i - 6)}:B{i})")
        ws.cell(i, 4, f"=SUM($B$2:B{i})")
    nd = len(ult["dias"]) + 1
    corpo(ws, 2, nd, 4, {1: "dd/mm/yyyy", 3: "0.0"})
    tabela(ws, "tbDiario", 4, nd)
    ws.cell(nd + 2, 1, "Dias conforme o relatório mais recente (o gerador agrupa em UTC: visitas após 21h de Brasília "
                       "caem no dia seguinte).").font = F_SUB

    ws = wb.create_sheet("Perfil")
    blocos = [("Dispositivo", "Dispositivo"), ("Sistema", "Sistema"), ("Canal", "Canal"), ("De onde vêm", "Tipo de origem"),
              ("Horário", "Hora (UTC)")]
    pos = {}
    coluna = 1
    for chave, rotulo in blocos:
        dados = ult["horas"] if chave == "Horário" else ult["perfil"].get(chave, [])
        if chave == "Horário":
            hora_col = coluna
        for ci, (nome, larg) in enumerate([(rotulo, 18), ("Visitas", 9)]):
            c = ws.cell(1, coluna + ci, nome)
            c.font, c.fill, c.alignment, c.border = F_H, FILL_H, CENTRO, BORDA
            ws.column_dimensions[get_column_letter(coluna + ci)].width = larg
        for r, (nome, v) in enumerate(dados, start=2):
            ws.cell(r, coluna, nome).border = BORDA
            ws.cell(r, coluna + 1, v).border = BORDA
        if chave == "Horário":
            ws.cell(1, coluna + 2, "Hora (Brasília)").font = F_H
            ws.cell(1, coluna + 2).fill, ws.cell(1, coluna + 2).border = FILL_H, BORDA
            ws.column_dimensions[get_column_letter(coluna + 2)].width = 14
            for r in range(2, len(dados) + 2):
                ws.cell(r, coluna + 2, f"=MOD({get_column_letter(coluna)}{r}+{M_FUSO},24)&\"h\"").border = BORDA
        pos[chave] = (coluna, len(dados) + 1)
        coluna += 4 if chave == "Horário" else 3
    for row in ws.iter_rows(min_row=2):
        for c in row:
            c.font = F_N

    # ---------- Vendas
    ws = wb.create_sheet("Vendas")
    col = ["Data", "Nº do pedido", "Produto", "Loja", "Campanha / origem", "Status", "Estado no ML", "Qtd",
           "Valor da venda (R$)", "Comissão (R$)", "% comissão", "Fonte", "Atualizado em", "Visitante do blog"]
    cabecalho(ws, col, [16, 20, 46, 18, 18, 11, 16, 6, 15, 13, 11, 22, 16, 22])
    pedidos = {v["pedido"] for v in vendas if v.get("pedido")}
    manuais = [v for v in preservado["vendas_manuais"] if not v.get("pedido") or v["pedido"] not in pedidos]
    todas = sorted(vendas + manuais, key=lambda v: (v["data"] is None, v["data"] or datetime.min), reverse=True)
    for i, v in enumerate(todas, start=2):
        valores = [v["data"], v.get("pedido", ""), v["produto"], v.get("loja", ""), v["campanha"], v["status"],
                   v.get("estado_ml", ""), v.get("qtd"), v["valor"], v["comissao"]]
        for ci, x in enumerate(valores, start=1):
            ws.cell(i, ci, x)
        ws.cell(i, 11, f'=IFERROR(J{i}/I{i},"")')
        ws.cell(i, 12, v["fonte"])
        ws.cell(i, 13, v.get("atualizado_em"))
        ws.cell(i, 14, visitante_do_pedido.get(v.get("pedido") or id(v), "não identificado no blog"))
    nvd = max(len(todas) + 1, 2)
    linhas_livres = nvd + 30
    corpo(ws, 2, linhas_livres, len(col), {1: "dd/mm/yyyy", 9: '"R$" #,##0.00', 10: '"R$" #,##0.00', 11: "0%",
                                           13: "dd/mm/yyyy hh:mm"})
    ws.conditional_formatting.add(f"N2:N{linhas_livres}", FormulaRule(formula=['LEFT($N2,1)="#"'], fill=FILL_OK))
    tabela(ws, "tbVendas", len(col), nvd)
    st = f"F2:F{linhas_livres}"
    ws.conditional_formatting.add(st, CellIsRule(operator="equal", formula=['"Aprovada"'], fill=FILL_OK))
    ws.conditional_formatting.add(st, CellIsRule(operator="equal", formula=['"Pendente"'], fill=FILL_NOTA))
    ws.conditional_formatting.add(st, CellIsRule(operator="equal", formula=['"Cancelada"'], fill=FILL_RUIM))
    ws.cell(1, 16, "Como preencher").font = F_SEC
    ajuda = ["1. No painel ML Afiliados > Vendas, exporte o relatório (CSV ou Excel) e salve em",
             "   D:\\mercado_livre\\vendas_afiliados. Ao atualizar, as vendas entram aqui sozinhas.",
             "2. Histórico permanente: 99_LOG_RELATORIOS\\vendas_historico\\historico_vendas.csv",
             "   (1 linha por nº do pedido; exportar de novo só ATUALIZA o estado, nunca duplica).",
             "3. Para lançar à mão: linha nova com Fonte = manual (é preservada). Se depois a",
             "   exportação trouxer o mesmo nº do pedido, vale a exportação.",
             "Status: Aprovada, Pendente (em revisão) ou Cancelada (não efetivada)."]
    ajuda.append("Visitante do blog: o painel liga a venda ao visitante que clicou no mesmo produto (aba Visitantes).")
    for i, txt in enumerate(ajuda, start=2):
        ws.cell(i, 16, txt).font = F_SUB
    ws.column_dimensions["P"].width = 80
    if avisos:
        ws.cell(11, 16, "Arquivos não lidos: " + " | ".join(avisos)).font = Font(name=FONTE, size=9, color="C00000")
    V = "Vendas!$A$2:$A$5000"
    VS, VC, VV = "Vendas!$F$2:$F$5000", "Vendas!$J$2:$J$5000", "Vendas!$I$2:$I$5000"

    # ---------- Resumo oficial do ML Afiliados (digitado do painel do ML; preservado)
    ws = wb.create_sheet("Resumo_ML")
    cabecalho(ws, RESUMO_ML_COLS, [14, 16, 10, 11, 10, 10, 14, 11, 14, 13, 13, 14, 11, 50])
    resumo = preservado.get("resumo_ml") or RESUMO_ML_INICIAL
    for i, linha in enumerate(resumo, start=2):
        for ci, x in enumerate(linha, start=1):
            entrada(ws.cell(i, ci), x)
    nr = len(resumo) + 1
    corpo(ws, 2, nr + 20, len(RESUMO_ML_COLS), {1: "dd/mm/yyyy", 7: '"R$" #,##0.00', 9: '"R$" #,##0.00',
                                               10: '"R$" #,##0.00', 11: '"R$" #,##0.00', 12: '"R$" #,##0.00'})
    for r in range(2, nr + 1):
        for ci in range(1, len(RESUMO_ML_COLS) + 1):
            ws.cell(r, ci).font, ws.cell(r, ci).fill = F_INPUT, FILL_INPUT
    ws.cell(nr + 22, 1, "Como usar: a cada consulta ao painel ML Afiliados, acrescente uma linha com os totais da tela "
                        "(o Painel usa a última linha). São os números OFICIAIS do ML: incluem vendas de todos os seus "
                        "links (blog, TikTok, WhatsApp...), não só do blog.").font = F_SUB
    RM = lambda col: f"INDEX(Resumo_ML!${col}$1:${col}$500,COUNTA(Resumo_ML!$A$1:$A${nr + 20}))"

    # ---------- Calc (apoio dos gráficos)
