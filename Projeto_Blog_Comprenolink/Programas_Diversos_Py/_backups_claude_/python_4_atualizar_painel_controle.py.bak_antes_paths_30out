def backup():
    if not os.path.exists(ARQ):
        return
    os.makedirs(PASTA_BACKUP, exist_ok=True)
    destino = os.path.join(PASTA_BACKUP, datetime.now().strftime("Painel_%Y%m%d_%H%M%S.xlsx"))
    shutil.copy2(ARQ, destino)
    antigos = sorted(glob.glob(os.path.join(PASTA_BACKUP, "Painel_*.xlsx")))
    for a in antigos[:-15]:
        os.remove(a)


def _dia_e_hora(caminho):
    m = re.search(r"(\d{4}-\d{2}-\d{2})_(\d{2})h(\d{2})", os.path.basename(caminho))
    return (m.group(1), m.group(2) + m.group(3)) if m else (None, None)


def arquivar_relatorios():
    """Guarda em _historico_relatorios uma cópia do ÚLTIMO relatório de cada dia (1 por dia).
    O histórico não se perde se a pasta principal for limpa; a pasta principal nunca é apagada."""
    os.makedirs(PASTA_HIST_HTML, exist_ok=True)
    for a in glob.glob(os.path.join(PASTA, "relatorio_acessos_anuncios_*.html")):
        destino = os.path.join(PASTA_HIST_HTML, os.path.basename(a))
        if not os.path.exists(destino) or os.path.getsize(destino) != os.path.getsize(a):
            shutil.copy2(a, destino)
    ultimo_do_dia = {}
    copias = glob.glob(os.path.join(PASTA_HIST_HTML, "relatorio_acessos_anuncios_*.html"))
    for a in copias:
        dia, hora = _dia_e_hora(a)
        if dia and (dia not in ultimo_do_dia or hora > _dia_e_hora(ultimo_do_dia[dia])[1]):
            ultimo_do_dia[dia] = a
    for a in copias:
        dia, _ = _dia_e_hora(a)
        if dia and ultimo_do_dia[dia] != a:
            os.remove(a)  # cópia mais antiga do mesmo dia (só dentro de _historico_relatorios)
    # o mesmo relatório pode estar nas duas pastas; a leitura descarta repetidos pela data de geração
    return sorted(glob.glob(os.path.join(PASTA, "relatorio_acessos_anuncios_*.html")) +
                  glob.glob(os.path.join(PASTA_HIST_HTML, "relatorio_acessos_anuncios_*.html")))


def consolidar_quadros(rels):
    """Grava as métricas de cada dia em historico_quadros.csv (1 linha por dia) e devolve a lista de quadros para
    o painel: todos os dias do CSV + o relatório mais novo completo (campanhas, produtos, visitantes...).
    Assim os HTML antigos podem ir para a Lixeira sem perder a evolução."""
    os.makedirs(os.path.dirname(HIST_QUADROS), exist_ok=True)
    dias = {}
    if os.path.exists(HIST_QUADROS):
        for r in csv.DictReader(open(HIST_QUADROS, encoding="utf-8-sig"), delimiter=";"):
            q = {k: r.get(k, "") for k in COLS_QUADROS}
            q["gerado"] = _data(q["gerado"])
            for k in ("ao_vivo", "visitas", "visitantes", "vindas_link", "cliques", "possiveis", "aprovadas",
                      "pendentes", "outras_paginas"):
                v = _valor(q[k])
                q[k] = int(v) if v is not None and float(v).is_integer() else v
            if q["gerado"]:
                dias[q["dia"]] = q
    for r in rels:
        q = r["q"]
        dia = q["gerado"].strftime("%Y-%m-%d")
        if dia not in dias or q["gerado"] >= dias[dia]["gerado"]:
            dias[dia] = dict(q, dia=dia)
    with open(HIST_QUADROS, "w", newline="", encoding="utf-8-sig") as f:
        w = csv.DictWriter(f, fieldnames=COLS_QUADROS, delimiter=";", extrasaction="ignore")
        w.writeheader()
        for dia in sorted(dias):
            linha = dict(dias[dia])
            linha["gerado"] = linha["gerado"].strftime("%Y-%m-%d %H:%M")
            w.writerow({k: ("" if linha.get(k) is None else linha.get(k)) for k in COLS_QUADROS})
    completo = max(rels, key=lambda r: r["q"]["gerado"])
    quadros = [{"q": dias[d]} for d in sorted(dias)]
    quadros = [completo if x["q"]["gerado"] == completo["q"]["gerado"] else x for x in quadros]
    if quadros[-1] is not completo:  # o CSV tem dia mais novo do que qualquer HTML (não deveria acontecer)
        quadros.append(completo)
    return quadros


def main():
    arquivos = arquivar_relatorios()
    if not arquivos:
        print("Nenhum relatorio_acessos_anuncios_*.html encontrado em", PASTA, "nem em", PASTA_HIST_HTML)
        return 1
    rels, vistos = [], set()
    for a in arquivos:
        try:
            r = ler_relatorio(a)
        except Exception as e:
            print("  ! ignorado", os.path.basename(a), "->", e)
            continue
        if r["q"]["gerado"] in vistos:
            continue
        vistos.add(r["q"]["gerado"])
        rels.append(r)
    # 1 quadro por dia: fica o último relatório de cada dia (os relatórios são acumulados)
    por_dia = {}
    for r in rels:
        dia = r["q"]["gerado"].date()
        if dia not in por_dia or r["q"]["gerado"] > por_dia[dia]["q"]["gerado"]:
            por_dia[dia] = r
    rels = sorted(por_dia.values(), key=lambda r: r["q"]["gerado"])
    rels = consolidar_quadros(rels)
    vendas, avisos = ler_vendas()
    vendas = consolidar_vendas(vendas)
    preservado = ler_preservados()
    anuncios, hist_anuncios = ler_status_anuncios()
    wb = montar(rels, vendas, preservado, avisos, anuncios, hist_anuncios)
    backup()
    try:
        wb.save(ARQ)
    except PermissionError:
        print("\nNão consegui salvar: feche a planilha no Excel e rode de novo.")
        return 2
    print(f"Painel atualizado: {ARQ}")
    print(f"  {len(rels)} relatório(s) · último {rels[-1]['q']['gerado']:%d/%m/%Y %H:%M} · {len(vendas)} venda(s) no histórico"
          f" · {len(preservado['vendas_manuais'])} manual(is) · {len(anuncios)} anúncio(s) verificados"
          f" ({sum(a['status'] != 'Ativo' for a in anuncios)} fora do ar)")
    for a in avisos:
        print("  ! vendas:", a)
    return 0


if __name__ == "__main__":
    sys.exit(main())
