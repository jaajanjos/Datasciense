# ---------------------------------------------------------------- situação dos anúncios no ML
def ler_status_anuncios():
    """(última verificação, histórico completo) a partir de anuncios_status\\historico_status_anuncios.csv."""
    caminho = os.path.join(PASTA_STATUS, "historico_status_anuncios.csv")
    if not os.path.exists(caminho):
        return [], []
    linhas = list(csv.DictReader(open(caminho, encoding="utf-8-sig"), delimiter=";"))
    for r in linhas:
        r["_dt"] = _data(r.get("verificado_em"))
        r["_item"] = int(r["item"]) if str(r.get("item", "")).isdigit() else 0
    linhas = [r for r in linhas if r["_dt"]]
    if not linhas:
        return [], []
    datas = sorted({r["_dt"] for r in linhas})
    ultima = [r for r in linhas if r["_dt"] == datas[-1]]
    # compara pelo link de afiliado: o nº do item muda quando o guia é reordenado
    anterior = {r.get("link_afiliado") or r["_item"]: r["status"]
                for r in linhas if len(datas) > 1 and r["_dt"] == datas[-2]}
    for r in ultima:
        r["_anterior"] = anterior.get(r.get("link_afiliado") or r["_item"], "")
    # itens que estavam na verificação anterior e saíram do guia
    atuais = {r.get("link_afiliado") for r in ultima}
    saiu = [r for r in linhas if len(datas) > 1 and r["_dt"] == datas[-2] and r.get("link_afiliado") not in atuais]
    for r in saiu:
        r["_saiu_do_guia"] = True
    # problemas primeiro, depois pela ordem do guia
    ultima.sort(key=lambda r: (r["status"] == "Ativo", r["_item"]))
    return ultima, linhas


